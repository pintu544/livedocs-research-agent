# Copy to .env and fill in. Never commit .env to git.
# Free key: https://serpapi.com/users/sign_up (250 searches/month, no card required)

# Required — SerpApi key used for all live searches
SERPAPI_API_KEY=

# Optional — raises GitHub API limits for reliable repo and maintenance data.
# Fine-grained read-only token; no repository permissions are required.
GITHUB_TOKEN=

# Server port (default 4000)
PORT=4000

# Optional — any OpenAI-compatible chat endpoint for richer AI summaries.
# Without these, the app uses an extractive report built from search snippets.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
